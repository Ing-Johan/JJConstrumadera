DJANGO_SECRET_KEY=change-me-to-a-strong-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
USE_SQLITE=True

# Configuración para producción con PostgreSQL
# Opción 1: DATABASE_URL (recomendado para Render - se genera automáticamente)
# DATABASE_URL=postgresql://user:password@host:port/dbname
#
# Opción 2: Variables individuales (si no se usa DATABASE_URL)
DB_NAME=construmadera
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Configuración de correo administrativo
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@localhost
ADMIN_EMAIL=admin@localhost
WHATSAPP_BUSINESS_NUMBER=3117195100
CONTACT_MAP_QUERY=JJ Construmadera S.A.S, Cl 22 #30b1, Montería, Córdoba

# Almacenamiento de archivos multimedia (imágenes del panel)
# USE_CLOUDINARY=False -> almacenamiento local (media/). USE_CLOUDINARY=True -> almacenamiento persistente en Cloudinary.
# En desarrollo déjalo en False. En producción (Render) cámbialo a True y completa las variables Cloudinary.
USE_CLOUDINARY=False
# Credenciales de Cloudinary (NUNCA subir valores reales a Git; se configuran como variables de entorno en Render)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

DJANGO_SECRET_KEY=change-me-to-a-strong-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
USE_SQLITE=True

# Configuración para producción con PostgreSQL
DB_NAME=construmadera
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Configuración de correo administrativo
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@localhost
ADMIN_EMAIL=admin@localhost
WHATSAPP_BUSINESS_NUMBER=3117195100
CONTACT_MAP_QUERY=JJ Construmadera S.A.S, Cl 22 #30b1, Montería, Córdoba

# Almacenamiento de archivos multimedia (imágenes del panel)
# USE_S3=False -> almacenamiento local (media/). USE_S3=True -> almacenamiento S3-compatible persistente.
# En desarrollo déjalo en False. En producción (Render) cámbialo a True y completa las variables AWS.
USE_S3=False
# Credenciales del bucket (NUNCA subir valores reales a Git; se configuran como variables de entorno en Render)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
# Opcional: dominio público del bucket/CDN si el proveedor lo requiere (ej. custom domain de Cloudflare R2)
AWS_S3_CUSTOM_DOMAIN=
